# Copy this file to terraform.tfvars and edit the values:
#   cp terraform.tfvars.example terraform.tfvars

# terraform.tfvars is listed in .gitignore, so your values are not saved in git.

# Optional: DNAT (SSH from the internet through the firewall).
# Set your public IPv4 address without a prefix (no /32) and uncomment the line.

# admin_source_ip = "192.0.2.1"